# ─────────────────────────────────────────────
# Dockerfile.seeder — Database Seeding Job
# Used to push schemas and run seed scripts in Prod/Dev
# ─────────────────────────────────────────────
FROM node:22-alpine

WORKDIR /app

# Install system dependencies needed for Prisma
RUN apk add --no-cache openssl libc6-compat

# Copy dependency definitions
COPY package.json yarn.lock ./

# Install all dependencies (Prisma needs devDependencies to compile the seed script)
RUN yarn install --frozen-lockfile

# Copy typescript and prisma configuration files
COPY tsconfig.json prisma.config.ts ./
COPY prisma ./prisma

# Generate Prisma Client, sync schema, then seed
CMD ["sh", "-c", "npx prisma generate && npx prisma db push && yarn seed"]
